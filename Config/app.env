# The one place the app's identity and signing choices live (read by scripts/build.sh and scripts/make-release.sh).
# To build under your own identity, change these; nothing else needs editing except EXECUTABLE_NAME if you rename the Swift target.

APP_NAME="Voice It"                      # shown to users; also the app bundle file name ("Voice It.app")
EXECUTABLE_NAME="VoiceIt"                # must match the executable product in Package.swift
BUNDLE_ID="io.github.rwwwl.voice-it"     # macOS ties granted permissions to this, so changing it means granting them again

# Who signs the build:
#   auto    the first "Apple Development" certificate in your keychain (a free Apple ID in Xcode is enough)
#   -       ad hoc: no certificate at all. Used by the shared release; permissions reset on every new build
#   "name"  the exact name of a certificate in your keychain
SIGN_IDENTITY="auto"

COPYRIGHT_HOLDER="rwwwl"
COPYRIGHT_YEAR="2026"
REPO_URL="https://github.com/rwwwl/voice-it"                              # shown in the About window once the source is public
